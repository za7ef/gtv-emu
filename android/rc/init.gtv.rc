# init.gtv.rc — إعداد جهاز gtv-emu لـ init أندرويد في مرحلته الثانية.
# لا توجد أقسام data/metadata حقيقية بعد، فتُستعمل tmpfs مؤقتًا.

on early-init
    setprop ro.crypto.state unsupported
    setprop debug.ld.all dlerror
    setprop odsign.verification.done 1
    setprop ro.zygote zygote64
    # خدمات غير مضمّنة في الصورة المصغّرة؛ تُعلَن جاهزيتها حتى لا يتوقف init في انتظارها
    setprop ro.casefolding.adjusted 1
    setprop keystore.module_hash.sent true
    setprop odsign.key.done 1
    setprop kcmdline.loaded 1
    setprop bpf.progs_loaded 1
    setprop arm64.memtag.bootctl_loaded 1
    # الرسوميات (مأخوذة من init_graphics.vendor.rc في Cuttlefish، والقيم من bootconfig)
    setprop ro.sf.lcd_density ${ro.boot.lcd_density}
    setprop ro.hardware.egl ${ro.boot.hardware.egl}
    setprop ro.hardware.gralloc ${ro.boot.hardware.gralloc}
    setprop ro.hardware.hwcomposer ${ro.boot.hardware.hwcomposer}
    setprop ro.vendor.hwcomposer.mode ${ro.boot.hardware.hwcomposer.mode}
    setprop ro.vendor.hwcomposer.display_finder_mode ${ro.boot.hardware.hwcomposer.display_finder_mode}
    setprop ro.vendor.hwcomposer.display_framebuffer_format ${ro.boot.hardware.hwcomposer.display_framebuffer_format}
    setprop ro.hardware.vulkan ${ro.boot.hardware.vulkan}
    setprop ro.cpuvulkan.version ${ro.boot.cpuvulkan.version}
    setprop ro.opengles.version ${ro.boot.opengles.version}
    setprop debug.sf.vsync_reactor_ignore_present_fences true

on fs
    mount tmpfs tmpfs /metadata nosuid nodev noatime mode=0755
    restorecon /metadata
    mkdir /metadata/apex 0700 root system
    mkdir /metadata/bootstat 0750 system log

on late-fs
    mount tmpfs tmpfs /data nosuid nodev noatime mode=0771,uid=1000,gid=1000
    restorecon /data
    trigger nonencrypted

on post-fs-data
    setprop vold.post_fs_data_done 1

# صدفة على المنفذ التسلسلي لأغراض التشخيص
on property:ro.debuggable=1
    start console
